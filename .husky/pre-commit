#!/usr/bin/env sh
echo "🔍 Running pre-commit checks..."

# Stage only files that pass all checks
STAGED_FILES=$(git diff --cached --name-only | grep -E '\.(js|ts|jsx|tsx|json|css|html)$' || true)

# ============================================================================
# 1. Format Check with Prettier
# ============================================================================
if [ -n "$STAGED_FILES" ]; then
  echo "📝 Formatting code with Prettier..."
  npm run format -- --ignore-unknown 2>/dev/null || true

  # Add formatted files back to staging
  echo "$STAGED_FILES" | xargs git add 2>/dev/null || true
fi

# ============================================================================
# 2. ESLint Check
# ============================================================================
if echo "$STAGED_FILES" | grep -E '\.(js|ts|jsx|tsx)$' >/dev/null; then
  echo "🔎 Running ESLint..."
  npm run lint 2>/dev/null || true
fi

# ============================================================================
# 3. Check for console.log in staged files
# ============================================================================
echo "⚠️  Checking for console.log statements..."
if echo "$STAGED_FILES" | xargs grep -n "console\.log\|console\.debug" 2>/dev/null | grep -v "// debug:" | grep -v "// build:"; then
  echo "⚠️  Found console.log in staged files (allowed for PWA debugging)"
else
  echo "✅ No debug logs found"
fi

# ============================================================================
# 4. Check version consistency if package.json changed
# ============================================================================
if echo "$STAGED_FILES" | grep -E "package\.json" >/dev/null; then
  echo "🔢 Checking version consistency..."

  PACKAGE_VERSION=$(node -p "require('./package.json').version" 2>/dev/null)
  echo "package.json version: $PACKAGE_VERSION"

  if [ -f "index.html" ]; then
    if ! grep -q "$PACKAGE_VERSION" index.html 2>/dev/null; then
      echo "⚠️  WARNING: Version not found in index.html"
      echo "Consider updating version in HTML file"
    fi
  fi
fi


# ============================================================================
# 5. Security: block sensitive files from being committed
# ============================================================================
ALL_STAGED=$(git diff --cached --name-only)

# Block keystore files
KEYSTORE=$(echo "$ALL_STAGED" | grep -E '\.(jks|keystore|p12|pfx)$' || true)
if [ -n "$KEYSTORE" ]; then
  echo "❌ Commit blocked: Keystore file detected!"
  echo "$KEYSTORE"
  exit 1
fi

# Block docs/private/ files
PRIVATE_DOCS=$(echo "$ALL_STAGED" | grep '^docs/private/' || true)
if [ -n "$PRIVATE_DOCS" ]; then
  echo "❌ Commit blocked: Files from docs/private/ cannot be committed."
  echo "$PRIVATE_DOCS"
  exit 1
fi

# Block real .env files (only .env.*.example are allowed) — skip deletions (D status)
ENV_FILES=$(git diff --cached --name-status | grep -E '^\s*[^D]\s+\.env\.' | awk '{print $2}' | grep -v '\.example$' || true)
if [ -n "$ENV_FILES" ]; then
  echo "❌ Commit blocked: .env file with real credentials detected!"
  echo "$ENV_FILES"
  echo "Use .env.*.example files to document the required structure."
  exit 1
fi

# Warn on hardcoded keystore passwords in staged diff
if git diff --cached | grep -Ei '^\+.*(keystorePassword|keyPassword|storePassword)\s*=\s*\S' 2>/dev/null | grep -v '^\+.*secrets\.' | grep -v '^\+.*#'; then
  echo "❌ Commit blocked: Hardcoded keystore password detected in diff!"
  exit 1
fi

# ============================================================================
# GITIGNORE AUDIT: Pflicht-Einträge (spiegelt reusable-gitignore-audit.yml)
# ============================================================================
echo "Checking .gitignore for required entries..."
GITIGNORE_PROBLEMS=0
set -f
REQUIRED_GITIGNORE_ENTRIES=".env .env.local credentials.json *.jks *.keystore *.p12 *.p8 docs/private/"
for entry in $REQUIRED_GITIGNORE_ENTRIES; do
  if ! grep -Fq "$entry" .gitignore 2>/dev/null; then
    echo "❌ ERROR: Missing required .gitignore entry: '$entry'"
    GITIGNORE_PROBLEMS=1
  fi
done
set +f
if [ "$GITIGNORE_PROBLEMS" -ne 0 ]; then
  echo "Add the missing entries to .gitignore before committing."
  exit 1
fi

echo ""
echo "✅ Pre-commit checks passed!"
echo ""
