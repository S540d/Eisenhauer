# Firebase Configuration - STAGING
# Environment: staging
# Base URL: /Eisenhauer/staging/
#
# ⚠️  CRITICAL: Use separate Firebase project for staging!
# Sharing Firebase projects across environments risks data corruption.
#
# 📖 Setup Guide: See FIREBASE_SETUP.md for step-by-step instructions
#
# Quick Start:
# 1. Create new Firebase project: https://console.firebase.google.com/
#    Project name: "eisenhauer-staging"
# 2. Add Web App → Copy config values
# 3. Replace placeholders below with real values
# 4. Test: npm run build:staging

# Replace these placeholders with your staging Firebase config
FIREBASE_API_KEY=your-staging-api-key-here
FIREBASE_AUTH_DOMAIN=eisenhauer-staging.firebaseapp.com
FIREBASE_PROJECT_ID=eisenhauer-staging
FIREBASE_STORAGE_BUCKET=eisenhauer-staging.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-staging-sender-id-here
FIREBASE_APP_ID=your-staging-app-id-here
FIREBASE_MEASUREMENT_ID=your-staging-measurement-id-here
