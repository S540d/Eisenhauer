# Firebase Configuration - TESTING
# Environment: testing
# Base URL: /Eisenhauer/testing/
#
# ⚠️  CRITICAL: Use separate Firebase project for testing (Issue #110)!
# Testing and Production data must NEVER be mixed!
#
# 📖 Setup Guide: See FIREBASE_SETUP.md for step-by-step instructions
#
# Quick Start:
# 1. Create new Firebase project: https://console.firebase.google.com/
#    Project name: "eisenhauer-testing"
# 2. Add Web App → Copy config values
# 3. Replace placeholders below with real values
# 4. Test: npm run build:testing

# Replace these placeholders with your testing Firebase config
FIREBASE_API_KEY=your-testing-api-key-here
FIREBASE_AUTH_DOMAIN=eisenhauer-testing.firebaseapp.com
FIREBASE_PROJECT_ID=eisenhauer-testing
FIREBASE_STORAGE_BUCKET=eisenhauer-testing.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-testing-sender-id-here
FIREBASE_APP_ID=your-testing-app-id-here
FIREBASE_MEASUREMENT_ID=your-testing-measurement-id-here
