# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Logs
*.log

# Firebase
# Note: Firebase API keys are safe to commit (client-side keys, security via Firebase Rules)
# firebase-config.js and environment.js are auto-generated at build time
# They are committed so GitHub Actions can deploy them (peaceiris/actions-gh-pages respects .gitignore)
.env
.env.local
.env.*.local

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android Build Outputs
*.apk
*.apk.idsig
*.aab

# Android Studio / Gradle
*.iml
.gradle/
local.properties
*.ipr
*.iws
build/
captures/
.externalNativeBuild/
.cxx/
Android/gradle-*/

# Keystore files (CRITICAL - NEVER COMMIT!)
*.jks
*.keystore
key.properties
Android/keystore/
Android/gradle.properties
Android/KEYSTORE_INFO.md
Android/BUILD_SUCCESS.md

# Generated files
bin/
gen/
out/

# Android Profiling
*.hprof

# Note: Android/ subdirectory has its own .gitignore
# gradlew, gradle-wrapper, and proguard-rules.pro SHOULD be committed!

# Playwright
playwright-report/
test-results/
playwright/.cache/

# Local GitHub templates (from .templates submodule)
# Only track via submodule, ignore local copies
.github/ISSUE_TEMPLATE/
.github/PULL_REQUEST_TEMPLATE/
twa-manifest.json
*.zip
