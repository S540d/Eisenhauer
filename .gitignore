# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Claude Code – nur .claude/commands/ wird versioniert (Issue #31)
# Alle maschinen-/projektlokalen .claude-Artefakte explizit ignorieren:
.claude/CLAUDE.md
.claude/settings.json
.claude/settings.local.json
.claude/memory/
.claude/todos/
.claude/cache/
.claude/data/
.claude/commands/README.md

# Private documentation (local only)
docs/private/

# Logs
*.log

# Firebase / Environment variables (contain API keys - use .env-*.example as template)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.testing

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
playwright-report/
test-results/
playwright/.cache/

# Build output (generated by Vite during CI/CD)
dist/

# Android Build Outputs
*.apk
*.apk.idsig
*.aab

# Android Studio / Gradle
*.iml
.gradle/
local.properties
*.ipr
*.iws
build/
captures/
.externalNativeBuild/
.cxx/
Android/gradle-*/

# Keystore files (CRITICAL - NEVER COMMIT!)
*.jks
*.keystore
*.p12
*.p8
credentials.json
key.properties
Android/keystore/
# Android/gradle.properties is committed (credentials-free); signing props passed via -P flags
Android/KEYSTORE_INFO.md
Android/BUILD_SUCCESS.md

# Generated files
bin/
gen/
out/

# Android Profiling
*.hprof

# Note: Android/ subdirectory has its own .gitignore
# gradlew, gradle-wrapper, and proguard-rules.pro SHOULD be committed!

# Playwright
playwright-report/
test-results/
playwright/.cache/

# Local GitHub templates (from .templates submodule)
# Only track via submodule, ignore local copies
.github/ISSUE_TEMPLATE/
.github/PULL_REQUEST_TEMPLATE/
twa-manifest.json
*.zip
coverage/

# Security: sensitive credentials (Issue #7 – reusable-gitignore-audit)
credentials.json
*.p12
*.p8
aab-archive/
